# Daily at 10 pm India time (the crawl can run for hours, so it starts in the evening). Persistent=true runs a
# missed one when the droplet next boots.
[Unit]
Description=Daily case progress crawl

[Timer]
OnCalendar=*-*-* 22:00:00 Asia/Kolkata
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
