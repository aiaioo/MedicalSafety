# Template for the production secrets file on the droplet.
#
# Copy this to /etc/case-manager/case-manager.env, fill in the real values,
# then lock it down so only the service account can read it:
#
#   sudo install -d -m 700 -o case-manager -g case-manager /etc/case-manager
#   sudo install -m 600 -o case-manager -g case-manager /dev/null /etc/case-manager/case-manager.env
#   sudo nano /etc/case-manager/case-manager.env   # paste in the real values
#
# This file itself (with real values) must never be committed -- only this
# .example template is tracked in git. case-manager.service loads it via
# systemd's EnvironmentFile=, so nothing in the app or its code ever needs to
# know a password -- see storage.py's module docstring.

DATABASE_URL=postgresql://case_manager_app:REPLACE_ME@localhost:5432/case_manager
